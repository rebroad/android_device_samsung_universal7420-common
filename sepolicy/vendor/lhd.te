# lhd.te

binder_use(lhd)

# lhd uses the system suspend AIDL service for its wake locks.
allow lhd hal_system_suspend_service:service_manager find;

# lhd uses Android's fwmark client socket to connect through netd.
allow lhd netd:unix_stream_socket connectto;

# netd retains and uses the connected lhd socket while applying fwmarks.
allow netd lhd:fd use;

# netd reads and writes the connected legacy lhd TCP endpoint while applying
# the socket's network mark.
allow netd lhd:tcp_socket { getopt read write };

allow lhd {
    efs_file
    sec_efs_file
}:dir search;

allow lhd {
    sysfs_lhd
    sysfs_sec_sensorhub
}:dir search;

allow lhd {
    sysfs_lhd
    sysfs_sec_sensorhub
    sysfs
}:file rw_file_perms;

allow lhd sysfs_sec_gps:lnk_file r_file_perms;

allow lhd gps_data_file:dir rw_dir_perms;
allow lhd gps_data_file:file create_file_perms;
allow lhd gps_data_file:fifo_file create_file_perms;

dontaudit lhd system_data_file:dir search;
